


procedure Mover3VecesAl_(direccionAMover){
    /*
proposito: Mueve el cabezal 3 veces desde la celda actual hacia una direccion dada
precondicion: debe haber al menos 3 celdas en alguna direccion
* parametro: direccionAMover - tipo: direccion. describe la direccion a la que se va a mover el cabezal desde la cenda actual
    */
    
    repeat(3){
        Mover(direccionAMover)
    }
}

procedure Poner6DeColor_(colorAPoner){
    /*
proposito: pone 6 bolitas de color en la celda actual
precondicion: ninguna
parametro: colorAPoner - tipo: color. describe el color del cual van a ser las bolitas de la celda actual
    */
    repeat(6){
        Poner(colorAPoner)
        
    }
}

procedure Poner_Al_(colorAPoner, direcciónDondePoner){
    /*
proposito:  dado un color
colorAPoner y una dirección direcciónDondePoner, ponga una bolita del color dado en la celda
vecina en la dirección dada, dejando el cabezal en dicha celda.

precondicion: debe haber al menos una celda vecina del cabezal en cualquier direccion 

parametro: 
    * colorAPoner - color: indica el color de la bolita a poner
    *direcciónDondePoner - direccion: indica la direccion en la cual se va a mover el cabezal
    */
    Mover(direcciónDondePoner)
    Poner(colorAPoner)
}


procedure ReemplazarUnaDe_Por_(colorAReemplazar, colorPorElCualReemplazar){
    /*
proposito: dado un primer color colorAReemplazar y un segundo color
colorPorElCualReemplazar, reemplaza una bolita del primer color por una del segundo color en la
celda actual.

precondicion: Existe al menos una bolita de color **colorAReemplazar** en la celda actual.

parametro:
    *colorAReemplazar - color: El color de la bolita que se desea sacar
    *colorPorElCualReemplazar - color: color de la bolita que se desea reemplazar
    */
    Poner(colorAReemplazar)
    Sacar(colorAReemplazar)
    Poner(colorPorElCualReemplazar)

}
    
