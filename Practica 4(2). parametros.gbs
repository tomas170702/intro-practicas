procedure RegistrarListadoDeFechas(){
    /*
        PROPÓSITO: 
            * Registrar un listado de fechas en el tablero
        PRECONDICIONES:
            * El cabezal debe estar en la posición inicial del tablero
    */
    // Implementación del registro de un listado de fechas

    EscribirFechaConDía_Mes_Año_(15, 6, 1918)
    Mover_VecesAl_(1, Norte)
    EscribirFechaConDía_Mes_Año_(23, 9, 1947)
    Mover_VecesAl_(1, Norte)    
    EscribirFechaConDía_Mes_Año_(1, 5, 1886)
    Mover_VecesAl_ (1, Norte)
    EscribirFechaConDía_Mes_Año_(6, 12, 2007)
    Mover_VecesAl_(1, Norte)
    EscribirFechaConDía_Mes_Año_(19, 3, 1911)
}


