//6.c)

procedure Pintar3Puntos_(colorPunto){
    /*
proposito:
    * pintar 3 puntos de color **colorPunto** diferentes entre si sobre la fila en direccion al Este
    dejando el cabezal en la posicion de origen
precondicion: 
    * debe haber al menos 6 celdas al Este
parametro:
    * **colorPunto**: Color - El color de los puntos a pintar
    */
    poner(colorPunto)
    repeat(2){
        Poner_ADistancia3Al_(colorPunto, Este) 
    }
    repeat(2){
        Mover3VecesAl_(Oeste)
    }
}

//7)

procedure PintarArcoIris(){
    /*
PROPOSITO:
    * Pinta un arcoiris en el tablero compuesto por 4 franjas de 3 puntos
    de colores Negro, Azul, Rojo y Verde, dejando el cabezal en la posicion de origen
PRECONDICION:
    * El cabezal se ecuentra en la posicion Sur-Oeste del tablero
    * Hay al menos 8 celdas disponibles al Este y 1 celdas disponibles al Norte
PARAMETRO:
    * No Hay
*/
    Pintar3Puntos_(Negro)
    Mover(Este)
    Pintar3Puntos_(Azul)
    Mover(Norte)
    Pintar3Puntos_(Verde) 
    Mover(Este)
    Mover(Sur)
    Pintar3Puntos_(Rojo)
    Mover_VecesAl_(2, Oeste)
    
}
//biblioteca:
procedure Mover_VecesAl_(cantidadAMover, direccionAMover) {
    /*
        PROPÓSITO: 
            *Mover el cabezal una cantidad  
            hacia una dirección **direccionAMover** 
        PARÁMETROS:
            * cantidadAMover: Número - La cantidad de posiciones a mover.
            * direccionAMover: Dirección - La dirección hacia la cual mover el cabezal.
        PRECONDICIONES:
            * Debe haber al menos **cantidadAMover** celdas en la dirección **direccionAMover**
            desde la celda actual.
    */
    repeat(cantidadAMover){
        Mover(direccionAMover)
    }
}
//

procedure Poner_DeColorRojo(cantidadAPoner){
    /*
    PROPÓSITO:
        * Poner puntos de color rojo en el tablero
    PRECONDICIONES:
        * La celda actual debe estar vacia
    PARÁMETROS:
        * cantidadAPoner: Número - La cantidad de puntos rojos a poner en la celda actual
    */
    repeat(cantidadAPoner){
        Poner(Rojo)
    }
}

procedure Poner_DeColor_(cantidadAPoner, colorAPoner){
    /*
        PROPÓSITO: 
            * Poner **cantidadAPoner** de color **colorAPoner** en el tablero
        PARÁMETROS:
            * cantidadAPoner: Número - La cantidad de puntos del color especificado a poner en la celda actual
            * colorAPoner: Color - El color de los puntos a poner
        PRECONDICIONES:
            * cantidadAPoner >= 0
    */
    repeat(cantidadAPoner){ 
        Poner(colorAPoner)
    }
}

procedure Sacar_DeColor_(colorASacar, cantidadASacar){
    /*
        PROPÓSITO: 
            * Sacar **cantidadASacar** de color **colorASacar** en el tablero
        PARÁMETROS:
            * colorASacar: Color - El color de los puntos a sacar
            * cantidadASacar: Número - La cantidad de puntos del color especificado a sacar en la celda actual
        PRECONDICIONES:
            * cantidadASacar > 0
    */
    repeat(cantidadASacar){ 
        Sacar(colorASacar)
    }
}

//12)
procedure IrAEsquinaAl_Y_(primeraDirección,
segundaDirección){
    /*
        PROPÓSITO: 
            * Mover el cabezal a la esquina del tablero en la dirección
             de la primera y segunda dirección dadas
        PARÁMETROS:
            * primeraDirección: Dirección - La primera dirección del borde
            * segundaDirección: Dirección - La segunda dirección del borde
        PRECONDICIONES:
            * **pimeraDirección** y **segundaDirección** 
            deben ser direcciones válidas (Norte, Sur, Este, Oeste)
            y ser perpendiculares entre sí
    */
    IrAlBorde(primeraDirección)
    IrAlBorde(segundaDirección)
}

//13)
procedure  EscribirFechaConDía_Mes_Año_(día, mes, año){
    /*
        PROPÓSITO: 
            * Escribir la fecha en el tablero con el formato "día/mes/año"
            es decir, primero el día (color Azul), luego el mes (color Rojo) y el año (color Verde)
        PARÁMETROS:
            * día: Número - El día a escribir
            * mes: Número - El mes a escribir
            * año: Número - El año a escribir
        PRECONDICIONES:
            * día, mes y año deben ser números válidos para una fecha
    */
    // Implementación de la escritura de la fecha en el tablero

    Poner_DeColor_(día, Azul)
    Mover(Este)
    Poner_DeColor_(mes, Rojo)
    Mover(Este)
    Poner_DeColor_(año, Verde)
}
