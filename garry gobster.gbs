//ESTO ESTA MAL (BUENA LA IDEA PERO RECICLARIA CODIGO)

procedure EliminarEnemigosPorDestrucciónDelDiario() {
    /*
        PROPÓSITO: elimina de gobwarts a todos los dementores y mortifagos que exitan
        PARAMETROS: no tiene  
        PRECONDICIONES:
            * ninguna
        observaciones:
        recorrido de transformacion
        recorriendo el castillo de gobwarts habitacion por habitacion
        y elimina a los enemigos que encuentre en las habitaciones
    */
    IrAlInicioEnUnRecorridoAl_YAl_(Norte, Este) //biblioteca
    while(haySiguienteHabitacionEnUnRecorridoAl_YAl_(Norte, Este)){ //biblioteca
        EliminarEnemigosSiHayAca()
        IrASiguienteHabitacionEnUnRecorridoAl_YAl_(Norte, Este)
    }
    EliminarEnemigosSiHayAca()
}


procedure EliminarEnemigosSiHayAca() {
    /*
        PROPÓSITO: 
            *Elimina a los enemigos de la habitacion Actual
            si el personaje pertenece a la categoria dementor
            y categoria mortifago.
        PRECONDICIONES:
            * ninguna
    */
    if (hayPersonajeDeCategoría_(categoríaMortifago())) {
        EliminarPersonaje()
    } elseif (hayPersonajeDeCategoría_(categoríaDementor()) ) {
        EliminarPersonaje() 
    }
}


// tmb queda bien: 

procedure EliminarEnemigosSiHayAca() {
    /*
        PROPÓSITO: 
            *Elimina a los enemigos de la habitacion Actual
            si el personaje pertenece a la categoria dementor
            y categoria mortifago.
        PRECONDICIONES:
            * ninguna
    */
    if (hayPersonajeDeCategoría_(categoríaMortifago()) || hayPersonajeDeCategoría_(categoríaDementor())) {
        EliminarPersonaje() 
    }
}

