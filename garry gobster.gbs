// Ejercicio 1)
function puedenGanarBatallaMagosContraMortifagos(){
    /*
    PROP: indica si los magos pueden derrotar a los mortifagos en una batalla.
    PREC: Ninguna
    PARA: -
    TIPO: Booleano
    */
    return(poderTotalDe_(categoríaMago()) > poderTotalDe_(categoríaMortifago()))
}

function poderTotalDe_(categoria){
    /*
    PROP: descrbe el poder total de la categoria *categoria* en todo Gobswarts
    PREC: la categoria dada debe ser un numero que represente a una categoria válida
    PARA: 
        - categoria: Numero, numero que describe la categoria del personaje a determinar su poder
    TIPO: Número
    OBSE: Recorrido de acumulacion sobre habitaciones de gobswarts, acumulando el poder magico de la categoria dada
    */
    IrAlInicioEnUnRecorridoAl_YAl_(Este, Norte) //biblioteca
    poderTotal := poderPersonajeHabitacionActualSiEs_(categoria)
    while (haySiguienteCeldaEnUnRecorridoAl_YAl_(Este, Norte)) {
        IrASiguienteCeldaEnUnRecorridoAl_YAl_(Este, Norte) 
        poderTotal := poderTotal + poderPersonajeHabitacionActualSiEs_(categoria)
    }
    return (poderTotal)
}

function poderPersonajeHabitacionActualSiEs_(categoria){
    /*
    PROP: describe el poder del personaje de categoria dada si hay ese personaje en la habitacion actual, si no hay describe 0
    PREC: la categoria dada debe ser un numero que represente a una categoria válida
    PARA: 
        - categoria: Numero, numero que describe la categoria del personaje a determinar su poder 
    TIPO: Número
    */
    return(choose
            poderMágicoDelPersonaje() when (hayPersonajeDeCategoría_(categoria))
            0                         otherwise)
}


//2)

function estáElSeñorGobscuroEnGobwarts() {
    /*
        PROPÓSITO: indica si el señor gobscuro esta en gobwarts
        TIPO: Booleano
        PRECONDICIONES:
            *ninguna
        OBSERVACIONES:
            recorrido de busqueda
            sin saber si esta
            busca a donde esta el señor gobscuro
            se sabe que es un mortifago, que oculta su poder por lo cual actualmente tine un valor de 1,
            y que de haber entrado en gobwarts deberia esta en una mazmorra
    */
    IrAlInicioEnUnRecorridoAl_YAl_(Este, Norte) //biblioteca
    while(haySiguienteHabitacionEnUnRecorridoAl_YAl_(Este, Norte) && not estaElSeñorGobscuroAca()){
        IrASiguienteHabitacionEnUnRecorridoAl_YAl_(Este, Norte) //biblioteca
    }
    return (estaElSeñorGobscuroAca())
}

function estaElSeñorGobscuroAca() {
    /*
        PROPÓSITO: indica si el señor gobscuro esta en la habitacion actual de gobwarts 0 sino
        TIPO: Booleano
        PRECONDICIONES:
            * ninguna
    */
    return (tipoDeHabitacion() == habitacionMazmorras() 
    && 
    hayPersonajeDeCategoría_(categoríaMortifago())
    &&
    poderMágicoDelPersonaje() == 1)
}

