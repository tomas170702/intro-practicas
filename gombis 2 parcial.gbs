//Ejercicio 1

function SeDetendraElAvanceDeGombis(){
    /*
    proposito: indica si se detiene el avance de gombis en el mapa
    tipo: Booleano
    precondicion: ninguna
    observaciones:
        *recorrido de busqueda
        *recorre el mapa sobre carriles
        *sin saber si hay gombis en el mapa
    */
    IrAPrimerCarril()
    IrAPrimerCeldaDelCarril()
    while(haySiguienteCarril() && not haygombi()){
        IrASiguienteCarril()
    }
    return (SeDentendraElAvanceDeGombisEnCarril())
}


procedure IrAPrimerCeldaDelCarril(){
    /*
    proposito: Ir hacia la primera celda en el carril actual
    precondicion: es el carril actual
    */
    IrAlBorde(Este)
}


function SeDentendraElAvanceDeGombisEnCarril(){
    /*
    proposito: indica si se detiene en avance de gombis en el carril actual
    tipo: Booleano
    precondicion: ninguna
    observaciones:
        *recorrido de busqueda, buscando una celda con gombis o con plantas
        *sobre celdas del carril
        *sin saber si hay gombis o plantas en el carril
    */
    IrAPrimerCeldaDelCarril()
    while(puedeMover(Este) && not(hayGombi() || hayPlanta())){
        Mover(Este)
    }
    return(not hayGombi() || hayPlanta())
}


//Ejercicio 2

function porcentajeActivoDeHordaDe_(cantidadDeGombis){
    /*
    proposito: describe el porcentaje de la horda que actualmente esta atacando el jardin 
    tipo: Numero
    precondicion: ninguna
    observaciones:
        *recorrido de acumulacion
        *sobre el mapa
        *acumula gombis sobre el mapa
    */
    cantidadTotalDeGombisAtacando := 0
    IrAprimerCarril()
    IrAPrimerCeldaDelCarril()
    while(haySiguienteCarril()){
        cantidadTotalDeGombisAtacando := cantidadTotalDeGombisAtacando + cantidadDeGombisAtacandoEnCarril()
        IrASiguienteCarril()
        }
    return(((cantidadTotalDeGombisAtacando + cantidadDeGombisAtacandoEnCarril()) * 100) div cantidadDeGombis)
}    

    
function cantidadDeGombisAtacandoEnCarril(){
    /*
    proposito: dezcribe la cantidad de gombis atacando en el carril
    tipo: Numero
    precondicion: ninguna
    observaciones:
        *recorrido de acumulacion
        *sobre un carriles del jardin
    *acumula la cantidad de gombis vistos en el carril
*/
    cantDeGombisAtacando := 0
    IrAPrimerCeldaDelCarril()
    while(puedeMover(Este)){
        cantDeGombisAtacando := cantDeGombisAtacando + cantDeGombisAtacandoEnCelda()
        Mover(Este)
    }
    return (cantDeGombisAtacando + cantDeGombisAtacandoEnCelda())
    }


    function cantDeGombisAtacandoEnCelda(){
    /*
    proposito: describe la cantidad de gombis en celda, o 0 si no hay gombis en la celda actual
    tipo: Numero
    precondicion: niguna
    */
    return (choose
        cantidadDeGombis when (hayGombi())
        0 otherwise
    )
}

//Ejercicio 3

procedure ExplotarMinaDeCalabaza(){
    /*
    proposito: explota la mina de calabaza en la celda actual
    precondicion: hay mina de calabaza en la celda actual
    observaciones:
        *recorrido de procesamiento 
        *sobre direcciones
        *elimina gombis 
    */
    EliminarGombisAca()
    EliminarPlanta()
    dirActual := minDir()
    while(dirActual /= maxDir()){
        EliminarGombisAl_(dirActual)
        dirActual := siguiente(dirActual)
    }
    EliminarGombisAl_(dirActual)
}


procedure EliminarGombisAl_(direccion){
    /*
    proposito: elimina gombis en la direccion actual en un recorrido
    precondicion: hay gombis en la direccion actual
    */
    if(puedeMover(direccion)){
        Mover(direccion)
        EliminarGombisAca()
        Mover(opuesto(direccion))
    }
}

procedure EliminarGombisAca() {
    /*
    proposito: Eliminar gombis en en la celda actual si hay
    precondicion: hay al menos un gombi en la celda actual
    */
    if (hayGombi()) {
        EliminarGombis()
    }
}


procedure EliminarGombis(){
    /*
    proposito: Eliminar gombis en en la celda actual
    precondicion: hay al menos un gombi en la celda actual
    */
    repeat (cantidadDeGombis()) {
        EliminarGombi()
    }
}

