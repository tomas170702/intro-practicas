function esCasillaSegura() {
    /*
        PROPÓSITO:  indica si la casilla actual es segura para revelar
        TIPO: Booleano
        PRECONDICIONES:
            * ninguna
    */

    return (estaCubierta() && not hayVecinaPeligrosa())
}

function hayVecinaPeligrosa(){
    /*
    proposito: indica si hay una casilla vecina peligrosa en el mapa
    tipo: Booleano
    precondicion: ninguna
    observaciones:
        *una casilla peligrosa es una casilla cubierta o con indicador
        *es un recorrido de busqueda
        *sin saber si hay una casilla vecina con indicador
        *se hace el recorrido una direccion que va actualizandose
    */
    dirActual := minDir()
    while (dirActual /= maxDir() && not hayVecinaCubiertaOConIndicador(dirActual)){
        dirActual := siguiente(dirActual)
    }
    return (hayVecinaCubiertaOConIndicador(dirActual))
}

function hayVecinaCubiertaOConIndicador(direccion) {
    /*
        PROPÓSITO: indica si hay una casilla vecina cubierta o que tenga un indicador
        TIPO: booleano
        PRECONDICIONES:
            *ninguna
    */
    return ((hayVecinaCubiertaAl_(direccion) || tieneIndicadorAl_(direccion)))
}

function tieneIndicadorAl_(direccion){
    /*
    proposito: indica si la casilla vecina tiene indicador
    tipo: Booleano
    precondicion: ninguna
    */
    return (puedeMover(direccion) && esVecinaConIndicadorAl_(direccion))
}


function esVecinaConIndicadorAl_(direccion){
    /*
        PROPÓSITO: indica si la casilla vecina tiene indicador
                    en direccion al **direccion**
        TIPO: booleano
        PRECONDICIONES:
            * existe al menos una casilla vecina con indicador
    */
    Mover(direccion)
    return (not estaCubierta(direccion) && hayIndicadorAca(direccion))
}


//2)

procedure Arriesgar() {
    /*
        PROPÓSITO: revela la casilla cubierta más riesgosa de la grilla
        PRECONDICIONES:
            * existe una celda mas riesgosa que el resto y esa casilla esta cubierta
        OBSERVACIONES:
            *recorrido de busqueda
            *sabiendo que existe una casilla con riego maximo
            *busca la casilla de mayor riesgo en el mapa
    */
    IrACasillaMásRiesgosa()
    Revelar()
}

procedure IrACasillaMásRiesgosa() {
    /*
    proposito: se dirige a la casilla mas riegosa del mapa
    precondicion: ninguna
    observaciones:
        *recorrido de busqueda
        *busca la casilla mas riegosa del mapa
        *recorre las casillas del mapa

    */
    IrAPrimerCasillaEnUnRecorridoAl_Y_(Norte, Este)
    while(not esCasillaMasRiesgosa()){
        IrSiguienteCasillaEnUnRecorridoAl_Y_(Norte, Este)
    }
}

1. mas abajo a nivel primitivo calcular numero en base a las vecinas // en direcciones
2. maximo entre los riesgos de las casillas (actual y su siguiente) //en toda la grilla/mapa
3. verificar si ese riesgo obtenido es el riesgo maximo absoluto -> revele
// calculo de cantidad -> subtarea recorrido de acumulacion al ser vecinas tiene que ser sobre direcciones

function esCasillaMasRiesgosa(){
    /*
    proposito: indica cuando la casilla es riesgosa
    tipo: Booleano
    precondicion: ninguna
    observaciones:
        *recorrido de buqueda sabiendo que se busca
        *se recorren casillas
        *se pide identificar casillas reveldas con indicador
    */
    return (estáCubierta() && riesgoAcá() == maximoRiesgo())
}

function riesgoAcá() {
    /*
    proposito: describe el riesgo de una casilla
    tipo: Numero
    precondicion: Está cubierta
    observaciones:
        *recurrido de Acumulacion
        *sobre direccion
        *se busca determinar el riesgo de una casilla
    */
    dirActual := minDir()
    riesgoAcumulado := riesgoAl_(dirActual)
    while(dirActual /= maxDir()) {
        dirActual := siguiente(dirActual)
        riesgoAcumulado := riesgoAcumulado + riesgoAl_(dirActual)
    }
    return(riesgoAcumulado)
}

function riesgoAl_(direccion) {
    /*
    porposito: describe el riego en una **direccion**
    tipo: Numero
    precondicion: ninguna
    */
    return(choose 
        1 when (puedeMover(direccion) && hayRiesgoAl_(direccion))
        0 otherwise
    )
}

function hayRiesgoAl_(direccion) {
    /*
    proposito: indica si hay riego en casilla Al **direccion**
    tipo: Booleano
    precondicion: exiate al menos una casilla en **direccion**
    */
    Mover(direccion)
    return(esCasillaReveladaYConIndicador())
}

function esCasillaReveladaYConIndicador(){
    /*
    proposito: indicar si la casilla actual está revelada y tiene indicador
    tipo: Booleando
    precondicion: ninguna
    */
    return (not estaCubierta && hayindicadorAca())
}


function maximoRiesgo() {
    /*
    proposito: decribe el riesgo maximo visto
    tipo: Numero
    precondicion: Ninguna
    observaciones:
        recorrido maximo-minimo
        busca el mayor riego
        entre todas las casillas del tablero
    */
    IrAPrimerCasillaEnUnRecorridoAl_Y_(Norte, Este)
    maximoRiesgoVisto := riesgoAcá()
    while(haySiguienteCeldaEnUnRecorridoAl_Y_(Norte, Este)){
        IrSiguienteCasillaEnUnRecorridoAl_Y_(Norte, Este)
        maximoRiesgoVisto := maximoEntre_Y_(maximoRiesgoVisto, riesgoAcá())//biblioteca
    } 
    return(maximoRiesgoVisto)
}

