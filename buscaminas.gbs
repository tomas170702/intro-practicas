function () {
    /*
    proposito:
    precondiciones:
    tipo Numero
    */
    direcciónActual := minDir() 
    riesgoAcumuladoPorAhora := 0
    riesgoMaximosRegistradoAhora := riesgoAcumuladoPorAhora
    while (direccionActual /= maxDir()) { 
        direcciónActual := siguiente(direcciónActual) 
        riesgoAcumuladoPorAhora := riesgoMaximosRegistrado
        riesgoMaximosRegistrado := maximoEntre_y_(riesgoMaximosRegistrado >= riesgoAcumuladoPorAhora)
    } 
    return (riesgoAcumuladoPorAhora) 
}

