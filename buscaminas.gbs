procedure Arriesgar() {
    /*
        PROPÓSITO: revela la casilla cubierta más riesgosa de la grilla
        PRECONDICIONES:
            * existe una celda mas riesgosa que el resto y esa celda esta cubierta
        OBSERVACIONES:
            *recorrido de busqueda
            *sabiendo que existe una casilla mas riesgosa que el resto
            *buscando la casilla de mayor riesgo en el mapa
    */
    IrAPrimerCasillaEnUnRecorridoAl_Y_(Norte, Este)
    while(not esCasillaConRiesgo(riesgoBuscado)){
        IrSiguienteCasillaEnUnRecorridoAl_Y_(Norte, Este)
    }
    Revelar()
}

// calculo de cantidad -> subtarea recorrido de acumulacion al ser vecinas tiene que ser sobre direcciones

function esCasillaConRiesgo_(riesgoBuscado) {
    /*
    Proposito: indica si la casilla actual es la mas riesgosa
    precondicion: ninguna
    tipo: Booleano
    observaciones: 
    */
    return(estáCubierta() && riesgoDeLaCasillaActual == riesgoBuscado) // el riesgo de la casilla actual es absoluto
}



// condicion del uno si cero sino -> subtarea del tipo booleano

function esCasillaReveladaYConIndicador() {
    /*
    proposito: Indica si la casilla actual esta revelada y con indicador.
    precondicion: ninguna
    tipo: booleano
    */
    return(esCasillaRevelada() && hayIndicadorAcá())
}










