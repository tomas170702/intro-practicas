// Ejercicio 1
function seDetendráElAvanceDeGombis() {
    \*
    proposito: indica si se detiene el avance de glmbis en el jardin
    precondicion: ninguna
    tipo: Booleano
    observaciones:
    .recorrido de busqueda sin saber
    .se recorre el mapa por carriles
    .
    *\
    //recorrido tablero por flas de izquierda a derecha
    IrAPrimerCarril()
    while(haySiguenteCarril() && seDentieneElAvanceDeGombisEnCarril()){//se pone aca para chequear que se cumpla en todos los carriles
        IrASiguienteCarril()
    }
    return (seDentieneElAvanceDeGombisCarril())
}

function seDentieneElAvanceDeGombisEnCarril() {
    \*
    proposito: indica si se detiene el avance de gombis en el carril actual
    precondicion: ninguna
    tipo: Booñeanl
    observaciones:
    *recorrido de busqueda
    *sin saber
    *sobre celdas del carril buscando si hay gombi o planta
    *\
    //recorrido por celdas de un carril
    IrAlBorde(Oeste)
    while (puedeMover(Este) && not(hayPlanta() || hayGombi())) {
        Mover(Este)
    }
    return (not hayGombi() || hayPlanta())
}


// Ejercicio 2
function porcentajeActivoDeHordaDe_(cantidadDeGombis) {
    //para que un gombi ataque tiene que estar en la misma celda que una planta
    //recorrido de acumulacion para ver cuantos gombis están atacando alguna planta
    cantDeGombisAtacando := 0
    IrAPrimerCarril()
    while(haySiguenteCarril()){
        cantDeGombisAtacando := cantDeGombisAtacando + cantDeGombisAtacandoEnCarril()
        IrASiguienteCarril()
    }
    return ((cantDeGombisAtacando + cantDeGombisAtacandoEnCarril()) * 100 div cantidadDeGombis())
}

function cantDeGombisAtacandoEnCarril() {
    cantDeGombisAtacando := 0
    IrAlBorde(Oeste)
    while (puedeMover(Este)){
        cantDeGombisAtacando := cantDeGombisAtacando + cantDeGombisAtacandoEnCelda()
        Mover(Este)
    }
    return (cantDeGombisAtacando + cantDeGombisAtacandoEnCelda())
}

function cantDeGombisAtacandoEnCelda(){
    return (choose
        cantidadDeGombis() when (hayPlanta())
        0 otherwise
    )
}


// Ejercicio 3
procedure ExplotarMinaDeCalabaza(){
    EliminarPlanta()
    EliminarGombisAca()
    dirActual := minDir()
    while(dirActual /= maxDir()){
        EliminarGombisAl_(dirActual)
        dirActual := siguiente(dirActual)
    }
    EliminarGombisAl_(dirActual)
}

procedure EliminarGombisAca(){
    if (hayGombi()) {
        EliminarGombis()
    }
}


procedure EliminarGombis(){
    // PREC: Hay al menos un Gombi en la celda actual
    repeat(cantidadDeGombis()){
        EliminarGombi()
    }
}


procedure EliminarGombisAl_(direccion){
    if(puedeMover(direccion)){
        Mover(direccion)
        EliminarGombisAca()
        Mover(opuesto(direccion)) //mover al opuesto para seguir con 
                                  //el while desde donde exploto la bomba
    }    
}

