// exc 1
function singularCon_(elemento) {
    /*
    proposito: dado un iunico elemento, describe la lista que tiene unicamente elemento dado
    tipo: [Elemento]
    parametro:
        *elemento: Elemento
    preocndicion:
        *ninguna
    */
    return ([elemento])
}
//exc 2
function segundoDe_(lista){
    /*
    proposito: describe el segudo elemento de una lista
    tipo: Elemento
    parametro:
        *lista: [Elemento]
    precondicion:
        la **lista** tiene al menos 2 elementos
    */
    return (resto(lista))
}
//exc 3
function esSingular_(lista){
    /*
    proposito: indica si la *lista* es singular
    tipo: Booleano
    parametro:
        *lista: [Elemento]
    precondicion:
        *ninguna
    */
    return (not(esVacia(lista)) && esVacia(lista))
}
//exc 4
//A
function primerCartaDeLaMano_(mano){
    /*
    proposito: describa la primera carta de la *mano*
    tipo: Carta
    paramentro:
        * mano: Carta
    preocndicion:
        *hay al menos una carta en la mano
    */
    return (primero(mano))
}
//B
function segundaCartaDeLaMano_(mano){
    /*
    proposito: describe la segunda carta a jugar
    tipo: Carta
    parametro:
        * mano: 
    precondicion:
        *hay al menos 2 cartas en la mano
    */
    return (primero(resto(mano)))
}
//C
function tercerCartaDeLaMano_(mano) {
    /*
    proposito: describa la tercera carta a jugar de la *mano*
    tipo: Carta
    precondicion: hay al menos 3 cartas en la mano
    */
    return (primero(resto(resto(mano))))
}
//D
function laMano_LuegoDeRobarUnaCartaDe_(mano, mazo){
    /*
    proposito:ue dada una “mano” y un “mazo” describe la mano
    resultante luego de robar la primera carta del mazo 
    y agregarla a la mano del jugador
    tipo: Carta
    parametro:
        * mano: Lista de Carta
        * mazo: Lista de Carta
    precondicion:
        * hay al menos una carta en el mazo
    */
    manoAlMomento := mano
    return (manoAlMomento ++ [primero(mazo)])
}
//E
function laMano_LuegoDeJugarUnaCarta(mano){
    /*
    proposito:  que dada una “mano”, describe la mano resultante luego
                de jugar la próxima carta de la mano.
    tipo: Lista de Carta
    parametro:
        * mano: Lista de Carta
    precondicion:
        * hay al menos una carta en la *mano*
    */
    return (resto(mano))
}
//F
function laMano_LuegoDeJugarLaSegundaCarta(mano){
    return ([primero(mano)] ++ resto(resto(mano)))
}

//exc 5 LA TIRA DE CARTAS 
//A
function primerasTresCartasDeLaTira_(tira){
    /*
    proposito: que dada una “tira”, describe una lista con las primeras 3
                de la misma
    tipo: Lista de Cartas
    parametro:
        * tira: Lista de Cartas
    precondicion:
        *hay al menos 3 cartas en la *tira*
    */
    return ([primero(tira)] ++ [primero(resto(tira))] ++ [primero(resto(resto(tira)))])
}
//B
function laMano_TieneJugadaParaAgregarALaTira_(mano, tira) {
    /*
    proposito: indique si la primera carta de la *mano* que puede jugar el jugador puede ser agregada en la *tira* o no
    tipo: Booleano
    parametros:
        * mano: Lista de Cartas
        * tira: Lista de Cartas
    precondicion:
        * hay al menos una carta en la *mano*
        * hay al menos una carta en la *tira*
    */
    return ((palo(primerCartaDeLaMano_(mano)) /= palo(primero(tira)) && 
            número(primerCartaDeLaMano_(mano)) < número(primero(tira))))
}

//C
function laTira_DespuésDeJugar_(tira, carta){
    /*
    proposito: describa la tira que resulta de jugar esa carta en esa tira
    tipo: Lista De Cartas
    parametros: 
        *tira: Lista De Cartas
        *Carta: Carta
    precondicion: 
        *hay al menos una carta en la tira
        *hay al menos una carta la mano
        * palo carta \= palo de la primera carta de la tira
        * numero carta < de la primera carta de la tira
    */
    return([carta] ++ tira)
}


//EXC 7 
function listaCon_Repetido_Veces(elemento, cantidad) {
    /*
    proposito: describe la lista que va del primero de los
    elementos, al segundo de los elementos, 
    pasando por cada elemento intermedio.
    tipo: Lista Elementos
    parametros:
    * elemento1: Elemento - El dato que se va a repetir (de cualquier tipo).
    * cantidad: Numero - La cantidad de veces que se debe repetir.
    precondicion:
    * **cantidad** >= 0
    */
    listaActual := []
    repeat (cantidad) {
        listaActual := listaActual ++ [elemento]
    }
    return (listaActual)
}


//Exc 8
function listaDesde_Hasta_(elemento1, elemento2){
    /*
    proposito: describe la lista que va del primero de los elementos, 
    al segundo de los elementos, pasando por cada elemento intermedio.
    tipo: Lista Elementos
    parametros:
        * elemento1: Elemento
        * elemento2: Elemento
    precondicion:
        * elemento1 <= elemento2
    observaciones:
        * recorrido de enumerativos
        * sobre elementos
        * enumerando los elementos de la lista
    */
    listaActual := []
    elementoactual := elemento1
    while(actual /= elemento2){
        listaActual := listaActual ++ [elementoactual]
        elementoactual := siguiente(elemento)
    }
    return (listaActual ++ [elementoactual])
}

//exc 9
function singular_Si_(elemento, condicion) {
    /*
    proposito: describe una lista con un único **elemento** dado Si la **condicion** es verdadera.
            Sí es falsa, la lista es una lista vacía.
    tipo: Lista Elemento
    parametro: 
        *elemento: Elemento
        *condicion: Booleano
    precondicion:
        *ninguna
    */
    return (choose [elemento] when (condicion)
            [] otherwise)
}

//exc 10
function  longitudDe_(lista){
    /*
    proposito: describa la cantidad de
        elementos de la misma.
    tipo: Lista
    parametro:
        * lista: Lista
    precondicion:
        *ninguna
    observaciones:
        *recorrido de acumulacion sobre elementos de la **lista** dada
    */
    listaRestante := lista
    cantidadContada := 0
    while (not esVacia(listaRestante)){
        cantidadContada := listaRestante + 1
        listaRestante := resto(listaRestante)
    }
    return (cantidadContada)
}

//exc 11
function sumatoriaDe_([numeros]){
    /*
    proposito: describe la suma de todos los elementos de una Lista de **numeros**
    tipo: Numero
    paramentros:
        * [numeros]: Lista Numero
    precondicion:
        * hay al menos un **numero** en la lista
    observaciones:
        *recorrido de acumulacion 
        *sobre lista de **numeros**
        *sumando todos los numeros de la lista entre si y devolviendo un resultado
    */
    listaRestante := [numeros]
    sumatoria := 0
    while (not esVacia(listaRestante)) {
        sumatoria := sumatoria + primero(listaRestante)
        listaRestante := resto(listaRestante)
    }
    return (sumatoria)
}

//exc 12
function productoriaDe_(listaDeNumeros){
    /*
    proposito: describa el producto de todos los elementos de la **listaDeNumeros**.
    tipo: Numero
    paramentro:
        * listaDeNumero: Lista
    precondicion:
        * ninguna
    */
    listaRestante := listaDeNumeros
    producto := 0
    while (not esVacia(listaRestante)) {
        producto := producto * primero(listaRestante)
        listaRestante := resto(listaRestante)
    }
    return (producto)
}
//exc 13
function puntosEn_(mano) {
    /*
    proposito: describe la cantidad de puntos que el jugador tiene en su **mano**
    tipo: Numero
    paramentro:
        *mano: Lista De Cartas
    precondicion:
    * ninguna
    observaciones:
    * recorrido de acumulacion
    * sobre una **mano** de cartas
    * acumulas puntos por cartas en **mano**
    */
    puntosAcumulados := 0
    foreach cartaActual in mano {
        puntosAcumulados := puntosAcumulados + puntosDeCarta_(cartaActual)
    }
    return (puntosAcumulados)
}

function puntosDeCarta_(carta){
    /*
    proposito: describe los puntos que otorga la **carta** dada
    tipo: Numero
    parametros:
        *carta: Carta - la carta a evaluar
    preocndicion:
        ninguna
    observaciones:
    * puntos == numero de carta     
    * esFigura_(carta) otorga 20 puntos
    */
    return (choose 20 when (esFigura_(carta))  
    numero(carta) otherwise)
}



//exc 14
function elementosDe_aumentadosEn_(listaDeNumeros, numero){
    /*
    proposito: dada una lista de números, y un número que representa una cantidad a aumentar. 
               describe la lista en donde cada elemento fue aumentado en la cantidad dada.
    tipo: Lista De Numeros
    paramentro:
        * listaDeNumeros: Lista
        * numero: Numero
    precondicion:
        * numero > 0 
    observaciones:
        * recorrido de procesamiento(transformacion) 
        * sobre **listadeNumeros**
        * suma **numero** a cada numero en **listaDeNumeros**
    */ 
    listaProcesada := []
    foreach numeroActual in listadeNumeros {
        listaProcesada := listaProcesada ++ [numeroActual + numero]
    }
    return (listaProcesada)
}
