// exc 1
function singularCon_(elemento) {
    /*
    proposito: dado un iunico elemento, describe la lista que tiene unicamente elemento dado
    tipo: [Elemento]
    parametro:
        *elemento: Elemento
    preocndicion:
        *ninguna
    */
    return ([elemento])
}
//exc 2
function segundoDe_(lista){
    /*
    proposito: describe el segudo elemento de una lista
    tipo: Elemento
    parametro:
        *lista: [Elemento]
    precondicion:
        la **lista** tiene al menos 2 elementos
    */
    return (resto(lista))
}
//exc 3
function esSingular_(lista){
    /*
    proposito: indica si la *lista* es singular
    tipo: Booleano
    parametro:
        *lista: [Elemento]
    precondicion:
        *ninguna
    */
    return (not(esVacia(lista)) && esVacia(lista))
}
//exc 4
//A
function primerCartaDeLaMano_(mano){
    /*
    proposito: describa la primera carta de la *mano*
    tipo: Carta
    paramentro:
        * mano: Carta
    preocndicion:
        *hay al menos una carta en la mano
    */
    return (primero(mano))
}
//B
function segundaCartaDeLaMano_(mano){
    /*
    proposito: describe la segunda carta a jugar
    tipo: Carta
    parametro:
        * mano: 
    precondicion:
        *hay al menos 2 cartas en la mano
    */
    return (primero(resto(mano)))
}
//C
function tercerCartaDeLaMano_(mano) {
    /*
    proposito: describa la tercera carta a jugar de la *mano*
    tipo: Carta
    precondicion: hay al menos 3 cartas en la mano
    */
    return (primero(resto(resto(mano))))
}
//D
function laMano_LuegoDeRobarUnaCartaDe_(mano, mazo){
    /*
    proposito:ue dada una “mano” y un “mazo” describe la mano
    resultante luego de robar la primera carta del mazo 
    y agregarla a la mano del jugador
    tipo: Carta
    parametro:
        * mano: Lista de Carta
        * mazo: Lista de Carta
    precondicion:
        * hay al menos una carta en el mazo
    */
    manoAlMomento := mano
    return (manoAlMomento ++ [primero(mazo)])
}
//E
function laMano_LuegoDeJugarUnaCarta(mano){
    /*
    proposito:  que dada una “mano”, describe la mano resultante luego
                de jugar la próxima carta de la mano.
    tipo: Lista de Carta
    parametro:
        * mano: Lista de Carta
    precondicion:
        * hay al menos una carta en la *mano*
    */
    return (resto(mano))
}
//F
function laMano_LuegoDeJugarLaSegundaCarta(mano){
    return ([primero(mano)] ++ resto(resto(mano)))
}

//exc 4 LA TIRA DE CARTAS 
//A
function primerasTresCartasDeLaTira_(tira){
    /*
    proposito: que dada una “tira”, describe una lista con las primeras 3
                de la misma
    tipo: Lista de Cartas
    parametro:
        * tira: Lista de Cartas
    precondicion:
        *hay al menos 3 cartas en la *tira*
    */
    return ([primero(tira)] ++ [primero(resto(tira))] ++ [primero(resto(resto(tira)))])
}
//B
function laMano_TieneJugadaParaAgregarALaTira_(mano, tira) {
    /*
    proposito: indique si la primera carta de la *mano* que puede jugar el jugador puede ser agregada en la *tira* o no
    tipo: Booleano
    parametros:
        * mano: Lista de Cartas
        * tira: Lista de Cartas
    precondicion:
        * hay al menos una carta en la *mano*
        * hay al menos una carta en la *tira*
    */
    return ()
}


