//Ejercicio 1)

procedure LlevarCamiónAlInicioDeUnRecorrido(){
    /*
    proposito: 
        *lleva el camion al inicio de un recorrido que inicia en la esquina (Este-Sur)
    precondicion:
        *las direcciones dadas son perpediculares
        *El cabezal se encuentra sobre el camion 
    */
    LlevarCamionAlBorde_(Sur)
    LlevarCamionAlBorde_(Este)
}

procedure LlevarCamionAlBorde_(direccion) {
    /*
        PROPÓSITO: lleva el camion hacia el borde de la **direccion** dada
        PARÁMETROS:
            *direccion: Direccion - indica la direccion del borde hacia donde se dirigie el camion
        PRECONDICIONES:
            * el cabezal se encuentra sobre el camion
    */
    while(puedeMover(direccion)){
        MoverCamionAl_(direccion)
    }
}


function elCamiónEstáAlFinalDeUnRecorrido() {
    /*
        PROPÓSITO: 
            *Que indica si el camión se encuentra en la ubicación de la
            esquina Norte-Oeste
        TIPO: booleano
        PRECONDICIONES:
            * No debe haber mas celdas al Norte Y al Este
            * el cabezal se encuentra sobre el camion
    */
    return (not(puedeMover(Norte)) && not(puedeMover(Oeste)))
}

procedure MoverCamiónAPróximaUbicación(){
        /*
    proposito: 
        * Que mueve el camión a la siguiente ubicación en un recorrido por el
        mapa hacia el Oeste y el Norte
    precondicion:
        *las direcciones dadas son perpediculares
        *hay proxima ubicacion en un recorrido
        * el cabezal se encuentra sobre el camion
    */
    if (puedeMover(Oeste)) {
        MoverCamionAl_(Oeste)
    } 
    else {
        MoverCamionAl_(Norte)
        LlevarCamionAlBorde_(Oeste)
    }
}


//Ejercicio 2

function direcciónHaciaLaCuálEstáElComprador() {
    /*
        PROPÓSITO: describe hacia qué dirección está el comprador
        TIPO: Direccion
        PRECONDICIONES:
            *el cabezal se encuentra sobre el camion
            *hay un paquete en la ubicación actual
            *el comprador de un paquete siempre se 
            encuentra en la misma fila o columna que la ubicación 
            en donde se recogió su paquete
        observaciones:
            *recorrido de busqueda
            *sobre direcciones
            *sabiendo que esta el comprador 
    */
    dirActual := minDir()
    while(dirActual /= maxDir() && not(estaELCompradorDe_En_(idDePaquete(), dirActual))){
        dirActual := siguiente(dirActual)
    }
    return(estaELCompradorDe_En_(idDePaquete(), dirActual))
}

function estaElCompradorDe_En_(idPaquete, direccion){
    /*
        PROPÓSITO: indica hacia que **direcicon** se encuentra el comprador de **idPaquete**
        PARÁMETROS:
            * idPaquete: Numero 
            * direccion: Direccion
        TIPO: booleano
        PRECONDICIONES:
            * ninguna
        observaciones:
            *recorrido de busqueda
            *sabiendo que esta el comprador
            *recorres ubicaciones del mapa

    */
    while(puedeMover(direccion) && not estaELCompradoDe_(idPaquete())){
        Mover(direccion)

    }
    return (estaELCompradoDe_(idPaquete()))
}


//ejercicio 3

Se desea llevar cada paquete que se encuentra en el mapa a su correspondiente comprador. Para ello, sabemos que
todo paquete tiene su comprador en la misma fila o columna que en el lugar en donde se lo recoge. Deseamos entonces
realizar el procedimiento LlevarTodosLosPaquetesDeASuComprador que lleva cada uno de los paquetes a su
correspondiente comprador



procedure LlevarTodosLosPaquetesDeASuComprador(){
    /*
    proposito: lleva cada uno de los paquetes a su
               correspondiente comprador
    precondicion:
        *El cabezal esta sobre el camion
        *el comprador de un paquete siempre se 
            encuentra en la misma fila o columna que la ubicación 
            en donde se recogió su paquete
    observaciones:
        *recorrido de transformacion
    */
    LlevarCamiónAlInicioDeUnRecorrido()
    while(not elCamiónEstáAlFinalDeUnRecorrido()){
        EntregarPaqueteACompradorSiHayAca()
        MoverCamiónAPróximaUbicación()
    }
    EntregarPaqueteACompradorSiHayAca()
}


procedure EntregarPaqueteACompradorSiHayAca(){
    /*
    proposito: entrega paquetes a comprador si hay en la ubicacion actual
    precondicion: 
            *el cabezal esta sobre el camion
            *hay un paquete en la ubicacion actual
    */
    
    if(hayPaquete()){
        EntregarPaquete_ACompradorAl_(idPaquete(), direcciónHaciaLaCuálEstáElComprador())
    }
}

procedure EntregarPaquete_ACompradorAl_(idPaquete, direccion) {
    /*
        PROPÓSITO: 
        PARÁMETROS:

        PRECONDICIONES:
            * ....
    */
    EntregarPaquete_ACompradorAl_A_(idPaquete, direccion, distanciaAlComprador(idPaquete, direccion))
}

procedure EntregarPaquete_ACompradorAl_A_(idPaquete, direccion, distancia) {
    RecogerPaquete_(idPaquete)
    Mover_CamionAl_(distancia, direccion)
    EntregarPaquete_AComprador(idPaquete)
    Mover_CamionAl_(distancia, opuesto(direccion))
}

function distanciaAlComprador(idPaquete, direccion) {
    // PREC: El camion está sobre un paquete
    //       Hay un comprador hacia la dirección dada
    distancia := 0
    while(not estáElCompradorDe_(idPaquete)) {
        Mover(direccion)
        distancia := distancia + 1
    }
    return(distancia)
}

procedure Mover_CamionAl_(distancia, direccion){
    /*
    proposito:
        * Mover camion *distancia* hacia *direccion*
    paranetro:
        *distancia: Numero - es la cantidad de ubicaciones que recorrio el camion hasta llegar al comprador
        *direccion: Direccion - es la direccion en la cual se encuentra el comprador
    precondicion:
        * el cabezal esta sobre el camion
    observaciones:
        *recorrido de transformacion
        *sobre ubicaciones del mapa
        *viaja hacia ubicacion del comprador
    */
    repeat (distancia) {
        MoverCamionAl_(direccion)
    }
}

//ejercicio 4
Como ya mencionamos un paquete puede contener un producto o un conjunto de productos. Para poder saber cuántos
productos se van a llevar en el camión en cuestión, el ID del paquete nos indica cuántos productos contiene el mismo. Si
el ID está entre 1 y 999 contiene un único producto, si está entre 1000 y 1999, contendrá 2, si está entre 2000 y 2999
contiene 3, si está entre 3000 y 3999 serán 4 y si está entre 4000 y 4999 serán 5. Un paquete no puede contener más de
5 productos, y por tanto no hay IDs mayores a 4999.
Se quiere poder determinar cuántos productos (productos, no paquetes) fueron comprados y están esperando ser
entregados en un determinado momento (es decir, todos los que hay en el mapa). Para ello se pide realizar la función
cantidadDeProductosARecoger que indique el total de productos que están esperando ser entregados a sus
compradores.

function cantidadDeProductosARecoger() {
    IrAPrimerUbiación()
    cantidad := 0
    while (haySiguienteUbicación()) {
        cantidad := cantidad + cantidadDeProductosARecogerAcá()
        PasarASiguienteUbicación()
    }
    return(cantidad + cantidadDeProductosARecogerAcá())
}

function cantidadDeProductosARecogerAcá() {
    return(choose
        1 when (idDePaquete() >= 1 && idDePaquete() <= 999)
        2 when (idDePaquete() >= 1000 && idDePaquete() <= 1999)
        3 when (idDePaquete() >= 2000 && idDePaquete() <= 2999)
        4 when (idDePaquete() >= 3000 && idDePaquete() <= 3999)
        5 when (idDePaquete() >= 4000 && idDePaquete() <= 4999)
        boom("ERROR MESSAGE") otherwise
    )
}

5. Una característica de la aplicación interesante es el concepto de que un comprador puede adquirir varios productos de
diversas tiendas y compartir el envío de todos como si fuera un único paquete. Para soportar esta característica se desea
implementar el procedimiento RealizarEntregaMultipaquete que funciona de la siguiente manera:
○ El camión recoge el paquete en la ubicación actual (se asume hay una paquete en la misma).
○ Sí en el mapa hay una ubicación que tenga el paquete con ID inmediatamente superior, el camión irá a
recoger dicho paquete (Ej. se recogió el paquete con ID 324, se busca el paquete con ID 325).
○ Se repite el segundo paso recogiendo el paquete superior (Ej. 326, luego 327, etc.). Así hasta que no haya
un paquete con ID consecutivo en ninguna ubicación del mapa o bien se haya llegado al límite de 300
paquetes en total (máximo que entran en el camión).
○ Finalmente se lleva los paquetes a su comprador, el cual seguro queda en línea recta, es decir, misma fila
o columna, desde la ubicación en donde se recogió el último paquete. Sabemos además que todos los
paquetes tienen el mismo comprador, el cual se identifica en el mapa como el comprador del primer
paquete que se recogió en este proceso.
Al momento de hacer una entrega multipaquete la restricción de no poder cargar mas de un paquete al camión se anula.
Adicionalmente, consultar por el id del paquete en el camión describe el id del primer paquete recogido en el camión, y al
dejar el primer paquete recogido al comprador, todo el resto de los paquetes recogidos durante el proceso también se
entregan con él.


procedure RealizarEntregaMultipaquete(){
    prec: hay un paquete en la ubi actual
    RecogerPaquete_(idDePaquete())
    if(hayPaqueteConId_(idDePaquete()+1)) {
        IrARecogerPaquete_(idDePaquete()+1)
    }
}

function hayPaqueteConId_(idPaquete){
    // Recorrido de busqueda sin llevar el cambion
    while(not hayPaquete()){
    Mover(direccion)
    }
    return(idDePaquete() + 1)
}

procedure IrARecogerPaquete_(idDePaquete){
    // Recorrido de busqueda llevando el cambion
    LlevarCamiónAlInicioDeUnRecorrido()
    while (not(elCamiónEstáAlFinalDeUnRecorrido && hayPaqueteConId_(idPaquete))) {
        
    }
}